# --- Required ---
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME"
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""
# Used only by `npm run db:seed` (password must be 12+ characters)
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://alibabatraveladvisor.com"

# --- SEO / analytics (all optional; nothing loads until set) ---
GOOGLE_SITE_VERIFICATION=""      # Search Console HTML-tag token (content value only)
NEXT_PUBLIC_GTM_ID=""            # GTM-XXXXXXX (preferred) ...
NEXT_PUBLIC_GA_ID=""             # ... or G-XXXXXXXXXX if not using GTM

# --- Monetization (leave off until AdSense is approved) ---
NEXT_PUBLIC_ADS_ENABLED="false"
NEXT_PUBLIC_ADSENSE_CLIENT=""
