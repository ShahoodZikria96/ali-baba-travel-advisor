# The website is a static export: there is NO database or secret on the website itself.
# Only optional build-time values (set before `npm run build:site`):
NEXT_PUBLIC_SITE_URL="https://alibabatraveladvisor.com"
GOOGLE_SITE_VERIFICATION=""   # only if you verify Search Console with the HTML-tag method
# Analytics IDs and ads are NOT set here: edit /site-config.json on the server (no rebuild needed).
# Database + admin login for the PHP backend live in /home/CPANELUSER/alibaba-config.php (see php/config.sample.php).
