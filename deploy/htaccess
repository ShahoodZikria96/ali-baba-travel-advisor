# Ali Baba Travel Advisor: static site on Apache (Namecheap cPanel).
# Uploaded as /public_html/.htaccess by the packaging script.

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
AddType image/webp .webp
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) One canonical host over HTTPS in a single hop: www.example.com -> https://example.com
#    (handled first so http://www never takes two redirects).
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# 2) Always HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2b) /something/index.html duplicates /something/ -> redirect to the clean URL
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)index\.html[\s?] [NC]
RewriteRule ^(.*?)index\.html$ /$1 [L,R=301]

# 3) Old / alternative URLs -> current pages (301)
RewriteRule ^visa/?$                    /visas/ [L,R=301]
RewriteRule ^visas/uae/?$               /visas/ [L,R=301]
RewriteRule ^countries/?$               /visas/ [L,R=301]
RewriteRule ^countries/([^/]+)/?$       /visas/$1/ [L,R=301]
RewriteRule ^services/?$                /visa-consultancy/ [L,R=301]
RewriteRule ^services/([^/]+)/?$        /visa-consultancy/$1/ [L,R=301]
RewriteRule ^blog/?$                    /guides/ [L,R=301]
RewriteRule ^blog/([^/]+)/?$            /guides/$1/ [L,R=301]
RewriteRule ^about-us/?$                /about/ [L,R=301]
RewriteRule ^contact-us/?$              /contact/ [L,R=301]
RewriteRule ^privacy/?$                 /privacy-policy/ [L,R=301]
RewriteRule ^terms-and-conditions/?$    /terms/ [L,R=301]
RewriteRule ^tours/?$                   /tour-packages/ [L,R=301]
RewriteRule ^hotels/?$                  /hotel-booking/ [L,R=301]
RewriteRule ^offices/?$                 /locations/ [L,R=301]
# Landing pages from the previous website that still receive organic clicks
RewriteRule ^packages/?$                /tour-packages/ [L,R=301]
RewriteRule ^dubai-tour-packages/?$     /tour-packages/ [L,R=301]
RewriteRule ^documentation/?$           /travel-documentation/ [L,R=301]
RewriteRule ^countries-info/?$          /visas/ [L,R=301]
</IfModule>

# Never serve secrets or source files.
<FilesMatch "(^config\.php$|^alibaba-config.*\.php$|\.(sql|md|log|bak)$)">
  Require all denied
</FilesMatch>

# Keep the admin panel and the content API out of search results even if a link leaks.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(admin|leads-portal|api)(/|$)" NOINDEX_AREA
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=NOINDEX_AREA
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header unset X-Powered-By

  # Browsers revalidate on every visit (cheap 304s) so a new upload shows immediately.
  # s-maxage lets a CDN cache rule (Cloudflare "Cache Everything") keep pages 5 minutes at the edge.
  <FilesMatch "\.(html|txt|xml|json)$">
    Header set Cache-Control "public, max-age=0, s-maxage=300, must-revalidate"
  </FilesMatch>
  # Hashed build files (/_next/static) get their own long-cache .htaccess.
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>
